{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MuChaBo Core Bot Configuration v1",
  "description": "Platform envelope containing the supported native Pydantic AI 2.63.0 AgentSpec subset. See bot-spec-api.md for cross-field rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bot_id", "version", "access_policy", "agent"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "bot_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/identifier"},
    "access_policy": {"type": "string", "enum": ["anonymous", "authenticated"]},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "instructions"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "instructions": {
          "type": "string", "minLength": 1, "maxLength": 16000,
          "allOf": [
            {"pattern": "\\S"},
            {"not": {"pattern": "\\{\\{"}},
            {"not": {"pattern": "\\}\\}"}}
          ]
        },
        "name": {"$ref": "#/$defs/identifier"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "not": {"pattern": "[^a-z0-9_-]"}
    }
  }
}
