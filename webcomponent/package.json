{
  "_comment": "TEMPORARY TRANSITIVE DEPENDENCY OVERRIDES FOR SECURITY FIXES",
  "overrides": {
    "basic-ftp": "6.2.4",
    "follow-redirects": "1.16.2",
    "glob@>=9": "14.0.2",
    "minimatch@>=7": "11.0.1",
    "pac-proxy-agent": {
      "get-uri": "8.0.2"
    },
    "undici": "7.30.1"
  },
  "name": "refarch-webcomponent",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26.13 <27",
    "npm": ">=11.20 <12"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "npm run pre-build && vue-tsc --build --noCheck && vite build && npm run post-build",
    "pre-build": "openapi-generator-cli generate",
    "post-build": "node ./processes/post-build.js && cyclonedx-npm --omit dev --omit optional --output-reproducible -o dist/application.cdx.json",
    "preview": "vite preview",
    "lint": "npm run pre-build && prettier . --check --cache && eslint . --cache --concurrency auto && vue-tsc --build --noEmit",
    "fix": "prettier . --write --cache && eslint . --fix --cache --concurrency auto"
  },
  "dependencies": {
    "@muenchen/muc-patternlab-vue": "10.0.2",
    "@vueuse/core": "14.4.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@tsconfig/node-lts": "26.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.11"
  }
}
