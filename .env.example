# muchabo core backend: copy to .env and replace the example credentials.

# Admin backend (read-only spec-reader service credential)
MUCHABO_ADMIN_BASE_URL=http://localhost:8086
MUCHABO_ADMIN_ACCESS_TOKEN=replace-with-admin-service-token

# LiteLLM gateway
MUCHABO_LITELLM_BASE_URL=http://localhost:4000/v1
MUCHABO_LITELLM_API_KEY=replace-with-litellm-api-key

# Langfuse tracing project
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key

# Required privacy settings; content capture and media uploads must stay disabled.
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=false
LANGFUSE_MEDIA_UPLOAD_ENABLED=false

# Optional backend settings
MUCHABO_APP_NAME=muchabo backend
MUCHABO_LOG_LEVEL=INFO
